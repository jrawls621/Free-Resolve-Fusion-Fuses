--[[
  ColorVibrance.fuse
  Colorizes footage along a black -> Color -> white ramp,
  so shadows stay dark and highlights burn to white.
  Install: drop into  .../Fusion/Fuses/  and restart (Fuses > Color > Color Vibrance).
]]

FuRegisterClass("ColorVibrance", CT_Tool, {
    REGS_Name          = "Color Vibrance",
    REGS_Category      = "Fuses\\Color",
    REGS_OpIconString  = "CVib",
    REGS_OpDescription = "Colorizes footage along a black / color / white ramp",
    REG_NoMotionBlurCtrls = true,
    REG_OpNoMask       = false,
    REG_NoBlendCtrls   = false,
})

local Params = [[
    float col[3];
    float vib;
    float pres;
    float bright;
    float gam;
    float boost;
    int   invert;
    int   fill;
    int   matte;
    int   srcsize[2];
    int   compOrder;
]]

local Kernel = [[
__DEVICE__ float luma601(float r, float g, float b) { return 0.299f * r + 0.587f * g + 0.114f * b; }

__DEVICE__ float mobius(float x, float g) { return g * x / (1.0f + (g - 1.0f) * x); }

// per-channel piecewise-linear ramp: black -> c -> white (extends past 1.0)
__DEVICE__ float ramp(float L, float c)
{
    c = _fminf(_fmaxf(c, 0.0f), 1.0f);
    if (c < 1e-4f) return (L <= 1.0f) ? 0.0f : (L - 1.0f);
    if (L <= 1.0f - c) return c * L;
    float k = 1.0f / (1.0f + c);
    if (L <= k) return (1.0f + c) * L + c - 1.0f;
    float slope = (1.0f - c * c) / c;
    if (L > 1.0f) return 1.0f + _fminf(slope, 1.0f + c) * (L - 1.0f);
    return c + slope * (L - k);
}

__DEVICE__ float3 vibranceMap(float L, __CONSTANTREF__ VibParams *p)
{
    L = _fmaxf(L, 0.0f);
    if (p->invert) L = 1.0f - _fminf(L, 1.0f);
    float ge = _powf(_fmaxf(p->gam, 0.001f), 0.992f);
    L = mobius(L, ge);
    L = L * p->bright;

    float r = ramp(L, p->col[0]);
    float g = ramp(L, p->col[1]);
    float b = ramp(L, p->col[2]);

    // Vibrance: 0..1 fades to gray, 1..2 pushes channels away from the strongest one
    float v = _fminf(_fmaxf(p->vib, 0.0f), 2.0f);
    if (v <= 1.0f) {
        r = L + (r - L) * v; g = L + (g - L) * v; b = L + (b - L) * v;
    } else {
        float t = v - 1.0f;
        float mx = _fmaxf(r, _fmaxf(g, b));
        float xr = _fmaxf(0.0f, r - 0.38f * (mx - r));
        float xg = _fmaxf(0.0f, g - 0.38f * (mx - g));
        float xb = _fmaxf(0.0f, b - 0.38f * (mx - b));
        r = r + (xr - r) * t; g = g + (xg - g) * t; b = b + (xb - b) * t;
    }

    // Preserve Luminance: rescale to the source luma, fitting into gamut
    float m = luma601(r, g, b);
    if (m > 1e-6f && p->pres > 0.0f) {
        float s = L / m;
        float pr = r * s, pg = g * s, pb = b * s;
        float mx = _fmaxf(pr, _fmaxf(pg, pb));
        if (mx > 1.0f && L < 1.0f) {
            float f = (1.0f - L) / (mx - L);
            pr = L + (pr - L) * f; pg = L + (pg - L) * f; pb = L + (pb - L) * f;
        }
        r = r + (pr - r) * p->pres;
        g = g + (pg - g) * p->pres;
        b = b + (pb - b) * p->pres;
    }
    return make_float3(_fmaxf(r, 0.0f), _fmaxf(g, 0.0f), _fmaxf(b, 0.0f));
}

__KERNEL__ void VibKernel(__CONSTANTREF__ VibParams *params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y);
    if (x < params->srcsize[0] && y < params->srcsize[1])
    {
        float4 c = _tex2DVecN(src, x, y, params->compOrder);
        float a = c.w;
        float r = c.x, g = c.y, b = c.z;
        if (a > 1e-6f) { r /= a; g /= a; b /= a; }

        float3 o = vibranceMap(luma601(r, g, b), params);

        // Fill Empty BG: composite over the colorized value of black, output opaque
        if (params->fill) {
            float3 bg = vibranceMap(0.0f, params);
            o.x = bg.x + (o.x - bg.x) * a;
            o.y = bg.y + (o.y - bg.y) * a;
            o.z = bg.z + (o.z - bg.z) * a;
            a = 1.0f;
        }

        // Matte Alpha: 1 = On (alpha = brightest channel), 2 = Only (white, alpha = luma)
        if (params->matte > 0) {
            float m;
            if (params->matte == 1) {
                m = _fmaxf(o.x, _fmaxf(o.y, o.z));
                if (m > 1e-6f) { o.x /= m; o.y /= m; o.z /= m; }
                else { o.x = 0.0f; o.y = 0.0f; o.z = 0.0f; }
            } else {
                m = luma601(o.x, o.y, o.z);
                o.x = 1.0f; o.y = 1.0f; o.z = 1.0f;
            }
            m = _saturatef(m);
            m = mobius(m, 1.0f + params->boost);
            a *= m;
        }

        c.x = o.x * a; c.y = o.y * a; c.z = o.z * a; c.w = a;
        _tex2DVec4Write(dst, x, y, c);
    }
}
]]

local function slider(name, id, def, mn, mx)
    return self:AddInput(name, id, {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = def, INP_MinScale = mn, INP_MaxScale = mx,
    })
end

local function checkbox(name, id)
    return self:AddInput(name, id, {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl",
        INP_Integer = true, INP_Default = 0,
    })
end

function Create()
    InColR = self:AddInput("Red", "ColorRed", {
        ICS_Name = "Color", LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        INP_Default = 0.5882, INP_MaxScale = 1.0, CLRC_ShowWheel = false,
        IC_ControlGroup = 1, IC_ControlID = 0,
    })
    InColG = self:AddInput("Green", "ColorGreen", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        INP_Default = 1.0, IC_ControlGroup = 1, IC_ControlID = 1,
    })
    InColB = self:AddInput("Blue", "ColorBlue", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        INP_Default = 0.0, IC_ControlGroup = 1, IC_ControlID = 2,
    })

    InVib    = slider("Vibrance",           "Vibrance",          1.0, 0.0, 2.0)
    InPres   = slider("Preserve Luminance", "PreserveLuminance", 1.0, 0.0, 1.0)
    InBright = slider("Brightness",         "Brightness",        1.0, 0.0, 4.0)
    InGamma  = slider("Gamma",              "Gamma",             1.0, 0.1, 4.0)
    InFill   = checkbox("Fill Empty BG",    "FillEmptyBG")
    InInvert = checkbox("Invert",           "Invert")
    InMatte  = self:AddInput("Matte Alpha", "MatteAlpha", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
        INP_Integer = true, INP_Default = 0,
        { CCS_AddString = "Off" },
        { CCS_AddString = "On" },
        { CCS_AddString = "Only" },
    })
    InBoost  = slider("Alpha Boost", "AlphaBoost", 1.0, 0.0, 4.0)

    InImage  = self:AddInput("Input", "Input", { LINKID_DataType = "Image", LINK_Main = 1 })
    OutImage = self:AddOutput("Output", "Output", { LINKID_DataType = "Image", LINK_Main = 1 })
end

function NotifyChanged(inp, param, time)
    if inp == InMatte and param then
        InBoost:SetAttrs({ IC_Visible = true, INPB_Disabled = (param.Value == 0) })
    end
end

function Process(req)
    local src = InImage:GetValue(req)
    local dst = Image({ IMG_Like = src, IMG_DeferAlloc = true })

    local node = DVIPComputeNode(req, "VibKernel", Kernel, "VibParams", Params)
    local p = node:GetParamBlock(Params)
    p.col[0]  = InColR:GetValue(req).Value
    p.col[1]  = InColG:GetValue(req).Value
    p.col[2]  = InColB:GetValue(req).Value
    p.vib     = InVib:GetValue(req).Value
    p.pres    = InPres:GetValue(req).Value
    p.bright  = InBright:GetValue(req).Value
    p.gam     = InGamma:GetValue(req).Value
    p.boost   = InBoost:GetValue(req).Value
    p.invert  = InInvert:GetValue(req).Value
    p.fill    = InFill:GetValue(req).Value
    p.matte   = InMatte:GetValue(req).Value
    p.srcsize[0] = src.DataWindow:Width()
    p.srcsize[1] = src.DataWindow:Height()
    p.compOrder  = src:IsMask() and 1 or 15
    node:SetParamBlock(p)

    node:AddInput("src", src)
    node:AddOutput("dst", dst)
    node:RunSession(req)

    OutImage:Set(req, dst)
end
